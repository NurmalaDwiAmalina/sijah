generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
  resetTokens PasswordReset[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id           String        @id @default(cuid())
  code         String        @unique
  nama         String
  noWa         String
  alamat       String
  gender       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  measurements Measurement[]
  orders       Order[]
}

model Measurement {
  id              String      @id @default(cuid())
  customerId      String
  judul           String
  kategori        String      @default("Atasan") // Atasan / Bawahan / Standar
  catatan         String?

  // Atasan
  lingkarLeher    Float?
  lebarBahu       Float?
  lingkarDada     Float?
  lingkarPinggang Float?
  panjangLengan   Float?
  panjangBaju     Float?

  // Bawahan
  lingkarPinggul  Float?
  lingkarPaha     Float?
  panjangCelana   Float?

  // Standar (S/M/L/XL/Custom)
  ukuranStandar   String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
}

model Order {
  id              String           @id @default(cuid())
  code            String           @unique
  judul           String
  customerId      String
  tglMasuk        DateTime
  tglEstimasi    DateTime
  jenisPakaian    String?
  fotoReferensi   String?
  status          String           @default("Antrean")
  catatan         String?
  totalHarga      Float             @default(0)
  statusBayar     String           @default("Belum Bayar")
  snapshotNama    String
  snapshotNoWa    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customer        Customer         @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  additionalCosts AdditionalCost[]
  payments        Payment[]
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  measurementId String?
  judulUkuran   String
  catatan       String?
  jumlah        Int
  hargaSatuan   Float
  subTotal      Float
  snapshotData  String?
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  measurement   Measurement? @relation(fields: [measurementId], references: [id])
}

model AdditionalCost {
  id      String @id @default(cuid())
  orderId String
  label   String
  amount  Float
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  code      String   @unique
  orderId   String
  jumlah    Float
  metode    String
  catatan   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
