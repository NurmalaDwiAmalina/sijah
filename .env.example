# Copy this file to `.env` and fill in real values
# DO NOT commit .env to git

# PostgreSQL — schema.prisma uses provider="postgresql" dan kode memakai
# `mode: "insensitive"` (fitur Postgres-only), jadi DATABASE_URL HARUS Postgres.
# Provider gratis: Neon / Vercel Postgres / Supabase.
# Setelah mengisi: `npx prisma db push` lalu `npm run db:seed`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Random string, min 32 chars. Generate: `openssl rand -base64 32`
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Vercel Blob (dipakai untuk upload foto referensi). Ambil di dashboard Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
